#!/usr/bin/env bash
# Copyright (c) 2025-2026 fei_cong(https://github.com/feicong/feicong-course)
set -euo pipefail

# ============================================================================
# Droid DDK - Driver Development Kit Manager
# ============================================================================
# A unified tool for building Android kernel modules using Docker containers
# or local Droid DDK installations.
#
# Features:
#   - Dual mode: local (native) and docker (containerized) builds
#   - Multiple image sources: GitHub, Docker Hub, CNB mirror
#   - Auto-detection of available targets in local mode
#   - Interactive shell with pre-configured build environment
#   - Self-updating capability
#
# Configuration:
#   ~/.droid-ddk/source  - Image source (cnb/github/docker)
#   ~/.droid-ddk/mode    - Run mode (local/docker)
#   ~/.droid-ddk/mapping.json - Target to clang version mapping
#   .ddk-version   - Project-level target version (in project directory)
#
# Environment Variables:
#   DDK_ROOT   - Local DDK installation path (default: /opt/droid-ddk)
#   DDK_TARGET - Default build target
#
# Target Resolution Priority:
#   1. Command line argument (--target or positional)
#   2. .ddk-version file in current directory
#   3. DDK_TARGET environment variable
#
# ============================================================================
# Platform Functions
# ============================================================================

droid_ddk_normalize_machine() {
  case "$1" in
    x86_64|amd64)
      printf '%s\n' linux-amd64
      ;;
    aarch64|arm64)
      printf '%s\n' linux-arm64
      ;;
    *)
      printf '不支持的Linux宿主架构：%s\n' "$1" >&2
      return 2
      ;;
  esac
}

droid_ddk_host_platform() {
  droid_ddk_normalize_machine "$(uname -m)"
}

droid_ddk_normalize_platform() {
  case "$1" in
    linux-amd64|linux/amd64)
      printf '%s\n' linux-amd64
      ;;
    linux-arm64|linux/arm64)
      printf '%s\n' linux-arm64
      ;;
    *)
      printf '不支持的平台：%s\n' "$1" >&2
      return 2
      ;;
  esac
}

droid_ddk_docker_platform() {
  case "$1" in
    linux-amd64)
      printf '%s\n' linux/amd64
      ;;
    linux-arm64)
      printf '%s\n' linux/arm64
      ;;
    *)
      printf '不支持的平台：%s\n' "$1" >&2
      return 2
      ;;
  esac
}

droid_ddk_artifact_platform() {
  case "$1" in
    linux-amd64|linux-arm64)
      printf '%s\n' "$1"
      ;;
    *)
      printf '不支持的产物平台：%s\n' "$1" >&2
      return 2
      ;;
  esac
}

# ============================================================================
# Global Variables
# ============================================================================

prog=$(basename "$0")
DROID_DDK_CONFIG_DIR="$HOME/.droid-ddk"
DROID_DDK_SOURCE_CONFIG="$DROID_DDK_CONFIG_DIR/source"
DROID_DDK_MODE_CONFIG="$DROID_DDK_CONFIG_DIR/mode"
DROID_DDK_MAPPING_JSON="$DROID_DDK_CONFIG_DIR/mapping.json"
DDK_ROOT="${DDK_ROOT:-/opt/droid-ddk}"
DROID_DDK_MODE=""
DROID_DDK_PLATFORM="${DROID_DDK_PLATFORM:-}"
DOCKER_PLATFORM=""
SOURCE=""
IMAGE_BASE=""
CMD=""
TARGET=""
MODULE_DIR=""
BUILD_DIR=""
MODULE_MODE=false
MAKE_ARGS=()
ENV_VARS=()
DOCKER_COMMON_ARGS=()
REPO_GITHUB="https://raw.githubusercontent.com/feicong/droid-ddk/main"
REPO_CNB="https://cnb.cool/feicong/droid-ddk/-/git/raw/main"

# ============================================================================
# Utility Functions
# ============================================================================

ensure_dependency() {
  local cmd=$1
  if ! command -v "$cmd" &> /dev/null; then
    echo "Error: '$cmd' is required but not installed" >&2
    echo "Please install '$cmd' and try again" >&2
    exit 1
  fi
}

resolve_docker_platform() {
  if [[ -z "$DROID_DDK_PLATFORM" ]]; then
    DROID_DDK_PLATFORM=$(droid_ddk_host_platform)
  else
    DROID_DDK_PLATFORM=$(droid_ddk_normalize_platform "$DROID_DDK_PLATFORM")
  fi
  DOCKER_PLATFORM=$(droid_ddk_docker_platform "$DROID_DDK_PLATFORM")
  DOCKER_COMMON_ARGS=(--platform "$DOCKER_PLATFORM" --rm -v "$BUILD_DIR":/build -w /build)
}

usage() {
  cat <<EOF
Usage: $prog <command> [options] [-- <make-args>]

Commands:
  list                                        List all pulled Droid DDK images
  list-all                                    List all available Droid DDK targets from repository
  pull <target>|--target <target>             Pull the configured droid-ddk:<target> image
  build [<target>] [--target <target>] [--module <dir>] [-- <make-args>]
                                              Run 'make' inside container (for building)
  clean [<target>] [--target <target>] [--module <dir>] [-- <make-args>]
                                              Run 'make clean' inside container
  compdb [<target>] [--target <target>] [-- <make-args>]
                                              Run 'make compdb' and update VSCode clangd settings
  shell [<target>] [--target <target>] [--module <dir>]
                                              Start an interactive shell in the container
  update                                      Update the standalone dddk command

Options:
  --target, -t   image tag like 'android17-6.18'
                 (Priority: command arg > .ddk-version file > DDK_TARGET env)
  --env, -e      pass environment variable (can be used multiple times)
                 Example: --env CONFIG_FOO=y -e CONFIG_BAR=n
  --module, -m   external kernel module directory; build, clean and shell
                 use the standard Kbuild command with this directory
  --platform     linux/amd64 or linux/arm64; defaults to the host architecture
  -h, --help     show this help

Target Resolution:
  1. Command line argument (--target or positional)
  2. .ddk-version file in current directory
  3. DDK_TARGET environment variable

Examples:
  $prog list
  $prog list-all
  $prog pull android17-6.18
  $prog pull --target android17-6.18
  $prog build android17-6.18 -- CFLAGS=-O2
  $prog build --target android17-6.18 -- CFLAGS=-O2
  $prog clean -t android17-6.18
  $prog compdb android17-6.18
  $prog build -t android17-6.18 -m ./my-driver -- -j8
  $prog clean -t android17-6.18 -m ./my-driver
  $prog shell android17-6.18
  $prog update

  # Using environment variables:
  $prog build android17-6.18 --env CONFIG_FOO=y -e CONFIG_BAR=n
  $prog shell -t android17-6.18 --env DEBUG=1

  # Using .ddk-version file:
  echo "android17-6.18" > .ddk-version
  $prog build    # Will use android17-6.18 from .ddk-version
  $prog clean    # Will use android17-6.18 from .ddk-version
EOF
}

# ============================================================================
# Configuration Functions
# ============================================================================

migrate_config() {
  # Migration: if ~/.droid-ddk is a file, migrate to directory structure
  if [[ -f "$DROID_DDK_CONFIG_DIR" && ! -L "$DROID_DDK_CONFIG_DIR" ]]; then
    echo "Migrating configuration from file to directory structure..."
    local old_source
    old_source=$(cat "$DROID_DDK_CONFIG_DIR")
    rm -f "$DROID_DDK_CONFIG_DIR"
    mkdir -p "$DROID_DDK_CONFIG_DIR"
    echo "$old_source" > "$DROID_DDK_SOURCE_CONFIG"
    echo "Migration completed: $DROID_DDK_CONFIG_DIR is now a directory"
  fi
}

ensure_config_dir() {
  if [[ ! -d "$DROID_DDK_CONFIG_DIR" ]]; then
    mkdir -p "$DROID_DDK_CONFIG_DIR"
  fi
}

configure_mode() {
  # Check if DDK_ROOT exists and configure mode
  if [[ -d "$DDK_ROOT" ]] && [[ ! -f "$DROID_DDK_MODE_CONFIG" ]]; then
    echo "DDK_ROOT ($DDK_ROOT) detected. Please select running mode:"
    echo "1. local  (use local DDK installation)"
    echo "2. docker (use Docker containers)"
    echo ""
    echo "Waiting 30 seconds (default: docker)..."

    local mode_choice=""
    if read -t 30 -p "Enter your choice (1/2): " mode_choice; then
      echo ""
    else
      echo ""
      echo "Timeout: defaulting to docker mode"
      mode_choice="2"
    fi

    case "$mode_choice" in
      1)
        echo "local" > "$DROID_DDK_MODE_CONFIG"
        echo "Selected: local mode"
        ;;
      2)
        echo "docker" > "$DROID_DDK_MODE_CONFIG"
        echo "Selected: docker mode"
        ;;
      *)
        echo "Invalid option, defaulting to docker mode" >&2
        echo "docker" > "$DROID_DDK_MODE_CONFIG"
        ;;
    esac
  fi

  # Determine running mode
  if [[ -f "$DROID_DDK_MODE_CONFIG" ]]; then
    DROID_DDK_MODE=$(cat "$DROID_DDK_MODE_CONFIG")

    # Validate mode value
    if [[ ! "$DROID_DDK_MODE" =~ ^(local|docker)$ ]]; then
      echo "Warning: Invalid mode '$DROID_DDK_MODE' in config, resetting to docker" >&2
      echo "docker" > "$DROID_DDK_MODE_CONFIG"
      DROID_DDK_MODE="docker"
    fi
  else
    DROID_DDK_MODE="docker"
  fi

  # Check dependencies for local mode
  if [[ "$DROID_DDK_MODE" == "local" ]]; then
    ensure_dependency jq
  fi
}

configure_source() {
  # Initialize config if not exists
  if [[ ! -f "$DROID_DDK_SOURCE_CONFIG" ]]; then
    echo "First run detected. Please select an image source:"
    echo "1. docker (docker.io/fsx199/droid-ddk)"
    echo "2. github (ghcr.io/feicong/droid-ddk)"
    echo "3. cnb (docker.cnb.cool/feicong/droid-ddk/droid-ddk)"
    echo ""
    echo "Waiting 30 seconds (default: docker)..."

    local choice=""
    if read -t 30 -p "Enter your choice (1/2/3): " choice; then
      echo ""
    else
      echo ""
      echo "Timeout: defaulting to docker source"
      choice="1"
    fi

    case "$choice" in
      1)
        echo "docker" > "$DROID_DDK_SOURCE_CONFIG"
        echo "Selected: docker source"
        ;;
      2)
        echo "github" > "$DROID_DDK_SOURCE_CONFIG"
        echo "Selected: github source"
        ;;
      3)
        echo "cnb" > "$DROID_DDK_SOURCE_CONFIG"
        echo "Selected: cnb source"
        ;;
      *)
        echo "Invalid option, defaulting to docker source" >&2
        echo "docker" > "$DROID_DDK_SOURCE_CONFIG"
        ;;
    esac
  fi

  # Read configured source
  SOURCE=$(cat "$DROID_DDK_SOURCE_CONFIG")

  # Validate source value
  if [[ ! "$SOURCE" =~ ^(cnb|github|docker)$ ]]; then
    echo "Warning: Invalid source '$SOURCE' in config, resetting to docker" >&2
    echo "docker" > "$DROID_DDK_SOURCE_CONFIG"
    SOURCE="docker"
  fi

  set_image_base
}

set_image_base() {
  if [[ -f "$DROID_DDK_MAPPING_JSON" ]] && command -v jq &> /dev/null; then
    local mapped_image
    mapped_image=$(jq -r --arg source "$SOURCE" '.registry["droid-ddk"][$source] // empty' "$DROID_DDK_MAPPING_JSON")
    if [[ -n "$mapped_image" ]]; then
      IMAGE_BASE="$mapped_image"
      return
    fi
  fi

  case "$SOURCE" in
    cnb)
      IMAGE_BASE="docker.cnb.cool/feicong/droid-ddk/droid-ddk"
      ;;
    github)
      IMAGE_BASE="ghcr.io/feicong/droid-ddk"
      ;;
    docker)
      IMAGE_BASE="docker.io/fsx199/droid-ddk"
      ;;
    *)
      echo "Warning: unknown source configuration '$SOURCE', using default docker source" >&2
      IMAGE_BASE="docker.io/fsx199/droid-ddk"
      ;;
  esac
}

download_mapping_json() {
  local mapping_url
  case "$SOURCE" in
    cnb)
      mapping_url="$REPO_CNB/mapping.json?download=true"
      ;;
    github|docker|*)
      mapping_url="$REPO_GITHUB/mapping.json"
      ;;
  esac

  echo "Downloading mapping.json from: $mapping_url"
  if curl -fsSL "$mapping_url" -o "$DROID_DDK_MAPPING_JSON"; then
    echo "Successfully downloaded mapping.json"
    return 0
  else
    echo "Error: failed to download mapping.json" >&2
    return 1
  fi
}

ensure_mapping_json() {
  # For local mode, ensure mapping.json exists
  if [[ "$DROID_DDK_MODE" == "local" ]] && [[ ! -f "$DROID_DDK_MAPPING_JSON" ]]; then
    download_mapping_json
  fi
}

init_config() {
  migrate_config
  ensure_config_dir
  configure_mode
  configure_source
  ensure_mapping_json
}

# ============================================================================
# Target Resolution Functions
# ============================================================================

# Read target from .ddk-version file in current directory
# Returns:
#   Echoes the target string if file exists and is valid
#   Echoes empty string if file doesn't exist or is empty
get_target_from_version_file() {
  local version_file=".ddk-version"

  if [[ -f "$version_file" ]]; then
    # Read and trim whitespace
    local target
    target=$(cat "$version_file" | tr -d '[:space:]')

    if [[ -n "$target" ]]; then
      echo "$target"
      return 0
    fi
  fi

  echo ""
  return 0
}

resolve_build_dir() {
  if [[ -n "$MODULE_DIR" ]]; then
    if [[ ! -d "$MODULE_DIR" ]]; then
      echo "Error: module directory not found: $MODULE_DIR" >&2
      exit 2
    fi
    BUILD_DIR=$(cd "$MODULE_DIR" && pwd -P)
    MODULE_MODE=true
  else
    BUILD_DIR=$(pwd -P)
    MODULE_MODE=false
  fi
}

# ============================================================================
# Argument Parsing Functions
# ============================================================================

# Parse command-line arguments and extract TARGET and MAKE_ARGS
# Args:
#   $@ - command and arguments (first arg is command name)
# Sets globals:
#   CMD - the command name (e.g., build, clean, shell)
#   TARGET - the build target (e.g., android17-6.18)
#   MAKE_ARGS - array of additional make arguments
parse_args() {
  CMD=$1
  shift

  TARGET=""
  MODULE_DIR=""
  MAKE_ARGS=()
  ENV_VARS=()

  # Simple flag/positional parser
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target|-t)
        TARGET="$2"; shift 2;;
      --env|-e)
        ENV_VARS+=("$2"); shift 2;;
      --module|-m)
        MODULE_DIR="$2"; shift 2;;
      --platform)
        DROID_DDK_PLATFORM=$(droid_ddk_normalize_platform "$2"); shift 2;;
      --help|-h)
        usage
        exit 0
        ;;
      --)
        shift
        MAKE_ARGS=("$@")
        break
        ;;
      -*)
        # unknown flag for wrapper - treat as error
        echo "Unknown option: $1" >&2
        exit 2
        ;;
      *)
        # positional: if no target yet, take this as target; otherwise treat as a make arg
        if [[ -z "$TARGET" ]]; then
          TARGET="$1"
        else
          MAKE_ARGS+=("$1")
        fi
        shift
        ;;
    esac
  done
}

# ============================================================================
# Local Mode Functions
# ============================================================================

# List available local DDK targets by checking directory existence
# Reads matrix from mapping.json and verifies:
#   - $DDK_ROOT/src/<android-version> exists
#   - $DDK_ROOT/clang/<clang-version> exists
# Displays:
#   - Available targets (both dirs exist): ✓
#   - Incomplete targets (one dir missing): ✗
#   - Missing targets (both dirs missing): not shown
# Note: jq dependency is checked in configure_mode() for local mode
local_list() {
  # Ensure mapping.json exists
  if [[ ! -f "$DROID_DDK_MAPPING_JSON" ]]; then
    echo "Error: mapping.json not found at $DROID_DDK_MAPPING_JSON" >&2
    echo "Please run 'dddk update' first" >&2
    exit 1
  fi

  echo "Available local Droid DDK targets:"
  echo "----------------------------"

  # Parse matrix from mapping.json
  local matrix_count
  matrix_count=$(jq '.matrix | length' "$DROID_DDK_MAPPING_JSON")

  local available_count=0
  local incomplete_count=0

  for ((i=0; i<matrix_count; i++)); do
    local android clang enabled toolchain_kind toolchain_dir
    enabled=$(jq -r --arg platform "$DROID_DDK_PLATFORM" \
      ".matrix[$i] | ((.platforms // []) | index(\$platform)) != null" \
      "$DROID_DDK_MAPPING_JSON")
    if [[ "$enabled" != "true" ]]; then
      continue
    fi
    android=$(jq -r ".matrix[$i].android" "$DROID_DDK_MAPPING_JSON")
    clang=$(jq -r ".matrix[$i].clang" "$DROID_DDK_MAPPING_JSON")
    toolchain_kind=$(get_platform_toolchain_kind)

    # Check if required directories exist
    local src_dir="$DDK_ROOT/src/$android"
    local kdir_dir="$DDK_ROOT/kdir/$DROID_DDK_PLATFORM/$android"
    if [[ "$toolchain_kind" == "aosp-clang" ]]; then
      toolchain_dir="$DDK_ROOT/clang/$clang/bin"
    else
      toolchain_dir=$(get_ndk_bin "$android")
    fi
    local src_exists=false
    local kdir_exists=false
    local toolchain_exists=false

    [[ -d "$src_dir" ]] && src_exists=true
    [[ -d "$kdir_dir" ]] && kdir_exists=true
    [[ -d "$toolchain_dir" ]] && toolchain_exists=true

    if $src_exists && $kdir_exists && $toolchain_exists; then
      echo "  $android ✓ (src: ✓, kdir: ✓, toolchain: ✓)"
      available_count=$((available_count + 1))
    elif $src_exists || $kdir_exists || $toolchain_exists; then
      local src_mark="✗"
      local kdir_mark="✗"
      local toolchain_mark="✗"
      $src_exists && src_mark="✓"
      $kdir_exists && kdir_mark="✓"
      $toolchain_exists && toolchain_mark="✓"
      echo "  $android ✗ (src: $src_mark, kdir: $kdir_mark, toolchain: $toolchain_mark)"
      incomplete_count=$((incomplete_count + 1))
    fi
    # Both don't exist - skip (no output)
  done

  echo ""
  if [[ $available_count -eq 0 ]] && [[ $incomplete_count -eq 0 ]]; then
    echo "No targets found in $DDK_ROOT"
    echo "Please ensure the following directories exist:"
    echo "  - \$DDK_ROOT/src/<android-version>"
    echo "  - \$DDK_ROOT/kdir/$DROID_DDK_PLATFORM/<android-version>"
    echo "  - 对应宿主平台的工具链目录"
  else
    echo "Summary: $available_count available, $incomplete_count incomplete"
  fi
}

# Get the corresponding clang version for a given Android target
# Args:
#   $1 - Android target name (e.g., android17-6.18)
# Returns:
#   Echoes the clang version string (e.g., clang-r416183b)
# Exit codes:
#   0 - Success
#   1 - Target not found in mapping.json
# Note: jq dependency is checked in configure_mode() for local mode
get_clang_for_target() {
  local target=$1

  if [[ ! -f "$DROID_DDK_MAPPING_JSON" ]]; then
    echo "Error: mapping.json not found at $DROID_DDK_MAPPING_JSON" >&2
    exit 1
  fi

  # Find clang version for the target
  local clang
  clang=$(jq -r ".matrix[] | select(.android == \"$target\") | .clang" "$DROID_DDK_MAPPING_JSON")

  if [[ -z "$clang" || "$clang" == "null" ]]; then
    echo "Error: No clang version found for target '$target'" >&2
    exit 1
  fi

  echo "$clang"
}

get_rust_for_target() {
  local target=$1

  if [[ ! -f "$DROID_DDK_MAPPING_JSON" ]]; then
    return 0
  fi

  local rust
  rust=$(jq -r ".matrix[] | select(.android == \"$target\") | .rust // empty" "$DROID_DDK_MAPPING_JSON")

  echo "$rust"
}

get_platform_toolchain_kind() {
  jq -r --arg platform "$DROID_DDK_PLATFORM" '.platforms[$platform].toolchainKind // empty' "$DROID_DDK_MAPPING_JSON"
}

get_ndk_bin() {
  local target=$1
  local ndk root bin
  ndk=$(jq -r --arg target "$target" '.matrix[] | select(.android == $target) | .ndk // empty' "$DROID_DDK_MAPPING_JSON")
  root=$(jq -r --arg platform "$DROID_DDK_PLATFORM" --arg ndk "$ndk" '.platforms[$platform].ndks[$ndk].root // empty' "$DROID_DDK_MAPPING_JSON")
  bin=$(jq -r --arg platform "$DROID_DDK_PLATFORM" --arg ndk "$ndk" '.platforms[$platform].ndks[$ndk].bin // empty' "$DROID_DDK_MAPPING_JSON")
  if [[ -z "$ndk" || -z "$root" || -z "$bin" ]]; then
    echo "Error: NDK configuration missing for $target on $DROID_DDK_PLATFORM" >&2
    exit 1
  fi
  printf '%s\n' "$DDK_ROOT/ndk/$root/$bin"
}

# Setup local build environment variables
# Args:
#   $1 - Android target name
# Sets exports:
#   DDK_ORIGINAL_PATH - backup of original PATH
#   KDIR - kernel source directory
#   CLANG_PATH - clang binary directory
#   PATH - prepends CLANG_PATH to PATH
#   CROSS_COMPILE, ARCH, LLVM, LLVM_IAS - build flags
# Note:
#   Call restore_local_env() after use to cleanup
setup_local_env() {
  local target=$1
  local clang rust toolchain_kind rust_kind

  clang=$(get_clang_for_target "$target")
  rust=$(get_rust_for_target "$target")
  toolchain_kind=$(get_platform_toolchain_kind)
  rust_kind=$(jq -r --arg platform "$DROID_DDK_PLATFORM" '.platforms[$platform].rust.kind // empty' "$DROID_DDK_MAPPING_JSON")

  # Backup PATH
  export DDK_ORIGINAL_PATH="$PATH"

  # Setup DDK environment
  export KDIR="$DDK_ROOT/kdir/$DROID_DDK_PLATFORM/$target"
  if [[ "$toolchain_kind" == "aosp-clang" ]]; then
    export CLANG_PATH="$DDK_ROOT/clang/$clang/bin"
  else
    export CLANG_PATH="$(get_ndk_bin "$target")"
  fi
  export PATH="$CLANG_PATH:$PATH"

  # Setup Rust if available
  if [[ "$rust_kind" == "aosp-prebuilt" && -n "$rust" ]]; then
    export RUST_PATH="$DDK_ROOT/rust/$rust/bin"
    if [[ -d "$RUST_PATH" ]]; then
      export PATH="$RUST_PATH:$PATH"
    fi
  fi

  export CROSS_COMPILE=aarch64-linux-gnu-
  export ARCH=arm64
  export LLVM=1
  export LLVM_IAS=1
  if [[ "$toolchain_kind" == "android-ndk" ]]; then
    export CLANG_TRIPLE=aarch64-linux-gnu-
    export CC="$CLANG_PATH/clang"
    export LD="$CLANG_PATH/ld.lld"
    export AR="$CLANG_PATH/llvm-ar"
    export NM="$CLANG_PATH/llvm-nm"
    export OBJCOPY="$CLANG_PATH/llvm-objcopy"
    export OBJDUMP="$CLANG_PATH/llvm-objdump"
    export STRIP="$CLANG_PATH/llvm-strip"
    export HOSTCC="$CLANG_PATH/clang"
    export HOSTCXX="$CLANG_PATH/clang++"
    if [[ -d "$DDK_ROOT/.cargo/bin" ]]; then
      export PATH="$DDK_ROOT/.cargo/bin:$PATH"
    fi
  fi

  # Verify directories exist
  if [[ ! -d "$KDIR" ]]; then
    echo "Error: Kernel source directory not found: $KDIR" >&2
    exit 1
  fi

  if [[ ! -d "$CLANG_PATH" ]]; then
    echo "Error: Clang directory not found: $CLANG_PATH" >&2
    exit 1
  fi

  # Export user-defined environment variables
  if [[ ${#ENV_VARS[@]} -gt 0 ]]; then
    for env_var in "${ENV_VARS[@]}"; do
      export "$env_var"
    done
  fi

  echo "Environment setup:"
  echo "  KDIR=$KDIR"
  echo "  CLANG_PATH=$CLANG_PATH"
  if [[ -n "${RUST_PATH:-}" ]]; then
    echo "  RUST_PATH=$RUST_PATH"
  fi
  echo "  ARCH=$ARCH"
  if [[ ${#ENV_VARS[@]} -gt 0 ]]; then
    echo "  Custom env vars:"
    for env_var in "${ENV_VARS[@]}"; do
      echo "    $env_var"
    done
  fi
  echo ""
}

# Restore environment after local build/clean operations
# Unsets all variables set by setup_local_env()
# This ensures the user's environment is not polluted
restore_local_env() {
  # Restore PATH
  if [[ -n "${DDK_ORIGINAL_PATH:-}" ]]; then
    export PATH="$DDK_ORIGINAL_PATH"
    unset DDK_ORIGINAL_PATH
  fi

  # Unset DDK-specific variables
  unset KDIR
  unset CLANG_PATH
  unset RUST_PATH
  unset CROSS_COMPILE
  unset ARCH
  unset LLVM
  unset LLVM_IAS
  unset CLANG_TRIPLE
  unset CC
  unset LD
  unset AR
  unset NM
  unset OBJCOPY
  unset OBJDUMP
  unset STRIP
  unset HOSTCC
  unset HOSTCXX
}

run_local_make() {
  if [[ ${#MAKE_ARGS[@]} -eq 0 ]]; then
    make "$@"
  else
    make "$@" "${MAKE_ARGS[@]}"
  fi
}

local_build() {
  echo "Building target: $TARGET"
  echo ""

  setup_local_env "$TARGET"

  echo "Running make..."
  if [[ "$MODULE_MODE" == "true" ]]; then
    run_local_make -C "$KDIR" M="$BUILD_DIR" modules
  else
    run_local_make
  fi

  local build_result=$?
  restore_local_env

  if [[ $build_result -eq 0 ]]; then
    echo ""
    echo "Build completed successfully"
  else
    echo ""
    echo "Build failed with exit code $build_result" >&2
    exit $build_result
  fi
}

local_clean() {
  echo "Cleaning target: $TARGET"
  echo ""

  setup_local_env "$TARGET"

  echo "Running make clean..."
  if [[ "$MODULE_MODE" == "true" ]]; then
    run_local_make -C "$KDIR" M="$BUILD_DIR" clean
  else
    run_local_make clean
  fi

  local clean_result=$?
  restore_local_env

  if [[ $clean_result -eq 0 ]]; then
    echo ""
    echo "Clean completed successfully"
  else
    echo ""
    echo "Clean failed with exit code $clean_result" >&2
    exit $clean_result
  fi
}

local_compdb() {
  echo "Generating compilation database for target: $TARGET"
  echo ""

  setup_local_env "$TARGET"
  local clangd_path="$CLANG_PATH/clangd"

  echo "Running make compdb..."
  run_local_make compdb

  local compdb_result=$?
  restore_local_env

  if [[ $compdb_result -ne 0 ]]; then
    echo ""
    echo "Compilation database generation failed with exit code $compdb_result" >&2
    exit $compdb_result
  fi

  echo ""
  echo "Compilation database generated successfully"

  # Update .vscode/settings.json
  local vscode_dir=".vscode"
  local settings_file="$vscode_dir/settings.json"
  echo "Updating VSCode settings..."

  # Create .vscode directory if it doesn't exist
  if [[ ! -d "$vscode_dir" ]]; then
    echo "Creating $vscode_dir directory..."
    mkdir -p "$vscode_dir"
  fi

  # Update or create settings.json
  if [[ -f "$settings_file" ]]; then
    local temp_file
    temp_file=$(mktemp)
    jq --arg path "$clangd_path" '.["clangd.path"] = $path' "$settings_file" > "$temp_file"
    mv "$temp_file" "$settings_file"
    echo "Updated clangd.path in $settings_file"
  else
    # File doesn't exist, create new one
    cat > "$settings_file" <<EOF
{
  "clangd.path": "$clangd_path"
}
EOF
    echo "Created $settings_file with clangd.path"
  fi

  echo ""
  echo "VSCode clangd settings updated: clangd.path = $clangd_path"
  echo "Compilation database setup completed successfully"
}

local_shell() {
  echo "Starting interactive shell for target: $TARGET"
  echo ""

  setup_local_env "$TARGET"

  echo "Environment variables set:"
  echo "  DDK_ROOT=$DDK_ROOT"
  echo "  KDIR=$KDIR"
  echo "  CLANG_PATH=$CLANG_PATH"
  if [[ -n "${RUST_PATH:-}" ]]; then
    echo "  RUST_PATH=$RUST_PATH"
  fi
  echo "  CROSS_COMPILE=$CROSS_COMPILE"
  echo "  ARCH=$ARCH"
  echo "  LLVM=$LLVM"
  echo "  LLVM_IAS=$LLVM_IAS"
  if [[ ${#ENV_VARS[@]} -gt 0 ]]; then
    echo "  Custom env vars:"
    for env_var in "${ENV_VARS[@]}"; do
      echo "    $env_var"
    done
  fi
  echo ""
  echo "Type 'exit' to leave the shell"
  echo "=========================================="
  echo ""

  # Start a new shell with the environment
  # Prefer bash if available, fall back to sh
  if command -v bash &> /dev/null; then
    bash --noprofile --norc
  else
    sh
  fi

  echo ""
  restore_local_env
  echo "Exited Droid DDK shell"
}

# ============================================================================
# Docker Mode Functions
# ============================================================================

run_docker() {
  # run_docker [extra docker args...] -- <cmd...>
  local docker_args=("${DOCKER_COMMON_ARGS[@]}")

  if [[ "$MODULE_MODE" == "true" ]]; then
    docker_args+=(--user "$(id -u):$(id -g)")
  fi

  # Add environment variables
  if [[ ${#ENV_VARS[@]} -gt 0 ]]; then
    for env_var in "${ENV_VARS[@]}"; do
      docker_args+=("-e" "$env_var")
    done
  fi

  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--" ]]; then shift; break; fi
    docker_args+=("$1"); shift
  done
  # remaining args are command to run
  docker run "${docker_args[@]}" "$IMAGE" "$@"
}

run_docker_make() {
  local image="$1"
  shift

  if [[ ${#MAKE_ARGS[@]} -eq 0 ]]; then
    IMAGE="$image" run_docker -- make "$@"
  else
    IMAGE="$image" run_docker -- make "$@" "${MAKE_ARGS[@]}"
  fi
}

# ============================================================================
# Command Handlers
# ============================================================================

cmd_list() {
  if [[ "$DROID_DDK_MODE" == "local" ]]; then
    local_list
  else
    echo "Pulled DDK images:"
    docker images --filter "reference=$IMAGE_BASE" --format "table {{.Repository}}\t{{.Tag}}\t{{.Size}}\t{{.CreatedAt}}"
  fi
}

cmd_list_all() {
  # Use local mapping.json if exists, otherwise download
  if [[ ! -f "$DROID_DDK_MAPPING_JSON" ]]; then
    echo "Local mapping.json not found, downloading..."
    if ! download_mapping_json; then
      exit 1
    fi
  fi

  echo "Available Targets (from local mapping.json):"
  echo "---------------------------------------------"

  ensure_dependency jq
  jq -r '[.matrix[] | select((.platforms // []) | length > 0) | .android] | unique[]' \
    "$DROID_DDK_MAPPING_JSON" | sed 's/^/  /'
}

install_update_file() {
  local source_file="$1"
  local destination="$2"

  if install -m 0755 "$source_file" "$destination" 2>/dev/null; then
    return
  fi
  echo "Need sudo permission to update $destination"
  sudo install -m 0755 "$source_file" "$destination"
}

update_self() {
  local script_path
  script_path="${BASH_SOURCE[0]}"
  script_path=$(readlink -f "$script_path" 2>/dev/null || realpath "$script_path" 2>/dev/null || echo "$script_path")

  local script_url
  case "$SOURCE" in
    cnb)
      script_url="$REPO_CNB/scripts/dddk?download=true"
      ;;
    github|docker|*)
      script_url="$REPO_GITHUB/scripts/dddk"
      ;;
  esac

  echo "Updating dddk at: $script_path"

  local temp_dir
  temp_dir=$(mktemp -d)
  if ! curl -fsSL "$script_url" -o "$temp_dir/dddk"; then
    rm -rf "$temp_dir"
    echo "Error: failed to download dddk update" >&2
    return 1
  fi

  if ! install_update_file "$temp_dir/dddk" "$script_path"; then
    rm -rf "$temp_dir"
    echo "Error: failed to install dddk update" >&2
    return 1
  fi

  rm -rf "$temp_dir"
  echo "Successfully updated dddk"
}

update_mapping() {
  echo "Updating mapping.json..."
  if download_mapping_json; then
    echo "Successfully updated mapping.json"
    return 0
  else
    echo "Warning: failed to update mapping.json" >&2
    return 1
  fi
}

cmd_update() {
  local update_success=true

  # Update dddk script
  if ! update_self; then
    update_success=false
  fi

  # Update mapping.json for all modes
  echo ""
  if ! update_mapping; then
    update_success=false
  fi

  if [[ "$update_success" == "false" ]]; then
    exit 1
  fi
}

cmd_pull() {
  if [[ "$DROID_DDK_MODE" == "local" ]]; then
    echo "Error: 'pull' command is not supported in local mode" >&2
    exit 1
  fi

  local image="$IMAGE_BASE:${TARGET}"
  echo "Pulling image: $image"
  docker pull --platform "$DOCKER_PLATFORM" "$image"
}

cmd_build() {
  if [[ "$DROID_DDK_MODE" == "local" ]]; then
    local_build
    return
  fi

  local image="$IMAGE_BASE:${TARGET}"
  echo "Building in container: $image"

  if [[ "$MODULE_MODE" == "true" ]]; then
    run_docker_make "$image" -C /kernel/out M=/build modules
  else
    run_docker_make "$image"
  fi
}

cmd_clean() {
  if [[ "$DROID_DDK_MODE" == "local" ]]; then
    local_clean
    return
  fi

  local image="$IMAGE_BASE:${TARGET}"
  echo "Cleaning in container: $image"
  if [[ "$MODULE_MODE" == "true" ]]; then
    run_docker_make "$image" -C /kernel/out M=/build clean
  else
    run_docker_make "$image" clean
  fi
}

cmd_compdb() {
  if [[ "$DROID_DDK_MODE" == "local" ]]; then
    local_compdb
    return
  fi

  local image="$IMAGE_BASE:${TARGET}"
  echo "Generating compilation database in container: $image"
  run_docker_make "$image" compdb
}

cmd_shell() {
  if [[ "$DROID_DDK_MODE" == "local" ]]; then
    local_shell
    return
  fi

  local image="$IMAGE_BASE:${TARGET}"
  echo "Starting interactive shell in: $image"
  # Prefer bash if available inside image, fall back to sh
  IMAGE="$image" run_docker -it -- sh -c 'if [ -x /bin/bash ]; then exec /bin/bash; else exec /bin/sh; fi'
}

# ============================================================================
# Main Function
# ============================================================================

main() {
  # Check for help or no arguments
  if [[ $# -lt 1 ]]; then
    usage
    exit 1
  fi

  if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    usage
    exit 0
  fi

  # Initialize configuration
  init_config

  # Parse command and arguments
  parse_args "$@"

  case "$CMD" in
    build|clean|shell)
      resolve_build_dir
      ;;
    compdb)
      if [[ -n "$MODULE_DIR" ]]; then
        echo "Error: --module is not supported by compdb" >&2
        exit 2
      fi
      BUILD_DIR=$(pwd -P)
      ;;
    *)
      if [[ -n "$MODULE_DIR" ]]; then
        echo "Error: --module is only supported by build, clean and shell" >&2
        exit 2
      fi
      BUILD_DIR=$(pwd -P)
      ;;
  esac

  case "$CMD" in
    list-all|update) ;;
    *) resolve_docker_platform ;;
  esac

  # Handle commands that don't need TARGET
  case "$CMD" in
    list)
      cmd_list
      exit 0
      ;;
    list-all)
      cmd_list_all
      exit 0
      ;;
    update)
      cmd_update
      exit 0
      ;;
  esac

  # Validate TARGET for commands that need it
  if [[ -z "$TARGET" ]]; then
    # Try .ddk-version file first
    local version_file_target
    version_file_target=$(get_target_from_version_file)
    if [[ -n "$version_file_target" ]]; then
      TARGET="$version_file_target"
      echo "Using target from .ddk-version: $TARGET"
    # Then try environment variable fallback
    elif [[ -n "${DDK_TARGET:-}" ]]; then
      TARGET="$DDK_TARGET"
      echo "Using target from DDK_TARGET: $TARGET"
    else
      echo "Error: target is required. Use --target or provide it as the first positional argument," >&2
      echo "       or create a .ddk-version file, or set DDK_TARGET environment variable." >&2
      usage
      exit 2
    fi
  fi

  # Handle commands that need TARGET
  case "$CMD" in
    pull)
      cmd_pull
      ;;
    build)
      cmd_build
      ;;
    clean)
      cmd_clean
      ;;
    compdb)
      cmd_compdb
      ;;
    shell)
      cmd_shell
      ;;
    *)
      echo "Unknown command: $CMD" >&2
      usage
      exit 2
      ;;
  esac
}

# ============================================================================
# Entry Point
# ============================================================================

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
